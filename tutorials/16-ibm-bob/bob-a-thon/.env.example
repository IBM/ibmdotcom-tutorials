# Copy this file to ".env" and paste your key:
#
#     cp .env.example .env          (Windows: copy .env.example .env)
#
# ".env" is git-ignored, so your key is never committed. Never share it or paste it in chat.

# One Sarvam key covers speech-to-text, the LLM and text-to-speech.
# Get one at https://dashboard.sarvam.ai
SARVAM_API_KEY=

# ── Optional — the defaults work, change only if you want to experiment ──
# SARVAM_STT_MODEL=saaras:v4
# SARVAM_CHAT_MODEL=sarvam-105b-conversations
# SARVAM_TTS_MODEL=bulbul:v3
# SARVAM_VOICE=anand
# PORT=8000
