# ─────────────────────────────────────────────────────────────────
# tutorial-formatter-agent — environment variables
# Copy this file to .env and fill in the values.
# .env is git-ignored and must NEVER be committed.
# ─────────────────────────────────────────────────────────────────

# IBM Cloud API key (required).
# Create one at https://cloud.ibm.com/iam/apikeys
WATSONX_API_KEY=your-ibm-cloud-api-key

# watsonx.ai project ID (required).
# Find this in your watsonx.ai project → Manage → General → Project ID
WATSONX_PROJECT_ID=your-project-id

# watsonx.ai service URL (optional).
# Defaults to the Dallas region. Change to match your provisioned region:
#   Dallas:   https://us-south.ml.cloud.ibm.com
#   Frankfurt: https://eu-de.ml.cloud.ibm.com
#   Tokyo:    https://jp-tok.ml.cloud.ibm.com
#   London:   https://eu-gb.ml.cloud.ibm.com
# WATSONX_URL=https://us-south.ml.cloud.ibm.com

# Model ID override (optional).
# Defaults to openai/gpt-oss-120b.
# Other options available on watsonx.ai:
#   ibm/granite-3-3-8b-instruct
#   meta-llama/llama-3-3-70b-instruct
#   mistralai/mistral-large
WATSONX_MODEL=openai/gpt-oss-120b
